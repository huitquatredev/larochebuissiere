---
interface Props {
  name: string;
  color: string;
  ink?: string;
  signature?: string;
  class?: string;
  id?: string;
}

const {
  name,
  color,
  ink = '#ffffff',
  signature = 'Antoine et Laurence Joly, vignerons. Faucon F-84110',
  class: className = '',
  id,
} = Astro.props;
---

<div
  class:list={['plate', className]}
  id={id}
  style={`--c:${color};--on:${ink}`}
>
  <div class="plate__band"></div>

  <div class="plate__flag" aria-hidden="true">
    <i></i><i></i>
  </div>

  <div class="plate__brand">La Roche Buissière</div>

  <div class="plate__flag" aria-hidden="true">
    <i></i><i></i>
  </div>

  <div class="plate__field">
    <span>{name}</span>
  </div>

  <div class="plate__dark">
    <span class="plate__sig">{signature}</span>
  </div>
</div>

<style>
  .plate {
    container-type: size;
    aspect-ratio: 1;
    margin: 0;
    display: grid;
    grid-template-rows: 9% 9% 9% 9% 32% 32%;
    background: #fff;
    color: var(--ink, #19171a);
    overflow: hidden;
    isolation: isolate;
  }

  .plate__band {
    background: var(--c);
  }

  .plate__flag {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .plate__flag i:first-child {
    background: var(--grey, #b8b9bb);
  }

  .plate__flag i:last-child {
    background: var(--ink, #19171a);
  }

  .plate__brand {
    display: grid;
    place-content: center;
    padding-inline: 4cqw;
    font-family: var(--sans, sans-serif);
    font-size: 4.3cqw;
    font-weight: 450;
    letter-spacing: 0.27em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
  }

  .plate__field {
    display: grid;
    place-content: center;
    padding: 2cqw 6cqw;
    background: var(--c);
    color: var(--on);
    text-align: center;
  }

  .plate__field span {
    font-family: var(--display, serif);
    font-size: 10cqw;
    line-height: 0.92;
    letter-spacing: -0.01em;
    font-optical-sizing: auto;
    font-variant-ligatures: no-common-ligatures;
    text-wrap: balance;
  }

  .plate__dark {
    display: flex;
    align-items: flex-end;
    padding: 4cqw;
    background: var(--ink, #19171a);
    color: #fff;
  }

  .plate__sig {
    font-family: var(--sans, sans-serif);
    font-size: 2.05cqw;
    letter-spacing: 0.055em;
    line-height: 1.3;
    color: color-mix(in srgb, #fff 88%, transparent);
  }
</style>
